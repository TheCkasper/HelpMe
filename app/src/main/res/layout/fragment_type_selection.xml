<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/helpme_background"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Selecciona el tipo de incidencia"
        android:textColor="@color/helpme_text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rgTypes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:layout_weight="1">

        <RadioButton
            android:id="@+id/rbMedical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@color/white"
            android:padding="16dp"
            android:text="Emergencia médica\n(Accidente, persona en riesgo, etc.)"
            android:textColor="@color/helpme_text_primary"
            android:textSize="16sp" />

        <RadioButton
            android:id="@+id/rbSecurity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@color/white"
            android:padding="16dp"
            android:text="Seguridad\n(Robo, violencia, sospechoso, etc.)"
            android:textColor="@color/helpme_text_primary"
            android:textSize="16sp" />

        <RadioButton
            android:id="@+id/rbDisaster"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@color/white"
            android:padding="16dp"
            android:text="Desastres naturales\n(Inundación, sismo, etc.)"
            android:textColor="@color/helpme_text_primary"
            android:textSize="16sp" />

        <RadioButton
            android:id="@+id/rbInfra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@color/white"
            android:padding="16dp"
            android:text="Infraestructura\n(Baches, calles, postes, etc.)"
            android:textColor="@color/helpme_text_primary"
            android:textSize="16sp" />

        <RadioButton
            android:id="@+id/rbServices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@color/white"
            android:padding="16dp"
            android:text="Servicios básicos\n(Agua, luz, etc.)"
            android:textColor="@color/helpme_text_primary"
            android:textSize="16sp" />

        <RadioButton
            android:id="@+id/rbOther"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@color/white"
            android:padding="16dp"
            android:text="Otros\n(Otra incidencia)"
            android:textColor="@color/helpme_text_primary"
            android:textSize="16sp" />
    </RadioGroup>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNext"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="12dp"
        android:text="Siguiente"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:backgroundTint="@color/helpme_green"
        app:cornerRadius="8dp" />

</LinearLayout>
